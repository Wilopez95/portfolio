# Contact form — get your key at resend.com/api-keys
# Without it, /api/contact only logs messages to the console.
RESEND_API_KEY=

# Email where you receive contact messages (must match your Resend account email on free tier)
CONTACT_EMAIL=

# Hidden admin area (/admin/cv). Changing it signs out every session.
ADMIN_PASSWORD=

# Vercel Blob (private store) for CV requests: `vercel env pull` fills these in.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
